# web: serves the Vue SPA and reverse-proxies backend paths to the api, so the app is same-origin
# (docs/architecture/overview.md §1, docs/deployment/coolify.md). TLS terminates at Traefik/Coolify.
#
# Environment:
#   WEB_PORT            listen port (default 8080; non-root)
#   API_UPSTREAM        api host:port (default api:8080)
#   PUBLIC_ENVIRONMENT  rendered into /config.json (whitelisted keys only, see config.json.tmpl)

# iCal feed URLs carry the secret token in the path (docs/architecture/ical-caldav.md §1): mask everything
# from `/ical/` on (query string included) in the request URI and Referer. Unanchored and tolerant of
# percent-encoding, because the path matcher below also proxies `//ical/…` and `/%69cal/…`. Used by the access log and by the default
# logger, which receives the error logs (e.g. a 502 from reverse_proxy) with the full request.
# Caddy already omits Cookie/Authorization header values.
(redacted_json) {
	format filter {
		wrap json
		fields {
			request>uri regexp "(?i)/(?:i|%69)(?:c|%63)(?:a|%61)(?:l|%6c)(?:/|%2f).*" "/ical/[REDACTED]"
			request>headers>Referer regexp "(?i)/(?:i|%69)(?:c|%63)(?:a|%61)(?:l|%6c)(?:/|%2f).*" "/ical/[REDACTED]"
		}
	}
}

{
	admin off
	auto_https off
	persist_config off
	servers {
		# Traefik (Coolify) sits in front: trust X-Forwarded-* from private networks only.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
	log {
		output stdout
		import redacted_json
	}
}

(security_headers) {
	header {
		# Strict CSP: no inline scripts or styles (Vite emits files; Vue sets styles via CSSOM).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Feed tokens are in URLs: never leak them via Referer to other origins.
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
		-Via
	}
}

:{$WEB_PORT:8080} {
	import security_headers
	encode zstd gzip

	# Access log, redacted like the default (error) log above.
	log {
		output stdout
		import redacted_json
	}

	handle /healthz {
		header Cache-Control "no-store"
		respond "OK" 200
	}

	# Runtime configuration for the SPA, rendered from environment variables on each request.
	handle /config.json {
		root * /srv
		header Content-Type "application/json"
		header Cache-Control "no-store"
		templates {
			mime application/json
		}
		file_server
	}

	@api path /api/* /ical/* /dav/* /.well-known/* /health/* /openapi/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
