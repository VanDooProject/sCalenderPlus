# web: serves the Vue SPA and reverse-proxies backend paths to the api, so the app is same-origin
# (docs/architecture/overview.md §1, docs/deployment/coolify.md). TLS terminates at Traefik/Coolify.
#
# Environment:
#   WEB_PORT            listen port (default 8080; non-root)
#   API_UPSTREAM        api host:port (default api:8080)
#   PUBLIC_ENVIRONMENT  rendered into /config.json (whitelisted keys only, see config.json.tmpl)
#   PUBLIC_BRAND_*      white-label branding in /config.json (all optional, see config.json.tmpl and
#                       deploy/.env.example); the origin of an https PUBLIC_BRAND_LOGO_URL is added to
#                       the CSP's img-src

# Secrets in URLs are masked in the request URI and the Referer (the SPA's own API calls send the page URL
# as Referer, same-origin):
# - iCal feed URLs carry the token in the path (docs/architecture/ical-caldav.md §1): everything from `/ical/`
#   on (query string included). Unanchored and tolerant of percent-encoding, because the path matcher below
#   also proxies `//ical/…` and `/%69cal/…`.
# - Email links carry tokens in the query string (docs/architecture/api.md §3–4: `/verify-email`,
#   `/reset-password`, `/invite`): the value of every parameter whose name contains `token`.
# Used by the access log and by the default logger, which receives the error logs (e.g. a 502 from
# reverse_proxy) with the full request. Caddy already omits Cookie/Authorization header values.
# Checked by deploy/caddy/test-log-redaction.sh (CI job docker, web images).
(redacted_json) {
	format filter {
		wrap json
		fields {
			request>uri multi_regexp {
				regexp "(?i)/(?:i|%69)(?:c|%63)(?:a|%61)(?:l|%6c)(?:/|%2f|%5c|\x5c).*" "/ical/[REDACTED]"
				regexp "(?i)((?:[?&]|%3f|%26)[^=&#]*token[^=&#]*=)[^&#]*" "${1}[REDACTED]"
			}
			request>headers>Referer multi_regexp {
				regexp "(?i)/(?:i|%69)(?:c|%63)(?:a|%61)(?:l|%6c)(?:/|%2f|%5c|\x5c).*" "/ical/[REDACTED]"
				regexp "(?i)((?:[?&]|%3f|%26)[^=&#]*token[^=&#]*=)[^&#]*" "${1}[REDACTED]"
			}
		}
	}
}

{
	admin off
	auto_https off
	persist_config off
	servers {
		# Traefik (Coolify) sits in front: trust X-Forwarded-* from private networks only.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
	log {
		output stdout
		import redacted_json
	}
}

(security_headers) {
	header {
		# Strict CSP: no inline scripts or styles (Vite emits files; Vue sets styles via CSSOM).
		# The only inline styles allowed are reka-ui's fixed scrollbar rules of the select and
		# combobox viewports, by hash (checked against the installed reka-ui in the frontend tests:
		# frontend/app/src/__tests__/csp.spec.ts). Images may also come from the brand logo's origin
		# ({brand_logo_origin}, empty unless PUBLIC_BRAND_LOGO_URL is an https URL; see the map below).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-60LHlRjW/B3CtzIoE/Lf1/NEDvko9efWMFaGVhHu/cs=' 'sha256-0sLsI2a+NIcumVvBF9zD/ArGqlZR2xfnxsALPmK7nj8='; img-src 'self' data: {brand_logo_origin}; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Feed tokens are in URLs: never leak them via Referer to other origins.
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-Via
	}
}

:{$WEB_PORT:8080} {
	# Origin (scheme, host, port) of an https brand logo for the CSP's img-src. Only a strict https
	# origin passes, so the variable can't inject other CSP directives; a same-origin path needs none.
	# The SPA applies the same rule (cspLogoUrlPattern in frontend/app/src/config.ts, tested against
	# this line) and shows its built-in mark for any other logo URL: keep both in sync.
	map {env.PUBLIC_BRAND_LOGO_URL} {brand_logo_origin} {
		~(?i)^\s*(https://[A-Za-z0-9.-]+(?::[0-9]+)?)(?:[/?#]\S*)?\s*$ "${1}"
		default ""
	}
	import security_headers
	encode zstd gzip

	# Access log, redacted like the default (error) log above.
	log {
		output stdout
		import redacted_json
	}

	handle /healthz {
		header Cache-Control "no-store"
		respond "OK" 200
	}

	# Runtime configuration for the SPA, rendered from environment variables on each request.
	handle /config.json {
		root * /srv
		header Content-Type "application/json"
		header Cache-Control "no-store"
		templates {
			mime application/json
		}
		file_server
	}

	# Web app manifest: the build's, with PUBLIC_BRAND_NAME as the installed app's name when set
	# (manifest.webmanifest.tmpl). Not cached by the service worker either.
	handle /manifest.webmanifest {
		root * /srv
		rewrite * /manifest.webmanifest.tmpl
		header Content-Type "application/manifest+json"
		header Cache-Control "no-cache"
		templates {
			mime application/manifest+json
		}
		file_server
	}
	handle /manifest.webmanifest.tmpl {
		respond 404
	}

	@api path /api/* /ical/* /dav/* /.well-known/* /health/* /openapi/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# Everything else revalidates, the service worker (sw.js) included, so a new version is found.
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
