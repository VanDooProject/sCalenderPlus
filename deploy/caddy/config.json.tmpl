{{- /*
  /config.json for the SPA (frontend/app/src/config.ts), rendered by Caddy on each request from
  whitelisted environment variables. Unset or empty brand values render as null (the app then uses
  its edition's defaults); strings go through toJson (JSON escaping); the hue is emitted only when
  it is a plain number from 0 to 360, anything else renders as null. The app validates every value
  again (https URLs or same-origin paths, email format, lengths).
*/ -}}
{{- $name := env "PUBLIC_BRAND_NAME" | trim -}}
{{- $logoUrl := env "PUBLIC_BRAND_LOGO_URL" | trim -}}
{{- $hue := env "PUBLIC_BRAND_HUE" | trim -}}
{{- $supportEmail := env "PUBLIC_BRAND_SUPPORT_EMAIL" | trim -}}
{{- $imprintUrl := env "PUBLIC_BRAND_IMPRINT_URL" | trim -}}
{{- $privacyUrl := env "PUBLIC_BRAND_PRIVACY_URL" | trim -}}
{{- $termsUrl := env "PUBLIC_BRAND_TERMS_URL" | trim -}}
{
  "environment": {{ env "PUBLIC_ENVIRONMENT" | default "production" | toJson }},
  "brand": {
    "name": {{ if $name }}{{ $name | toJson }}{{ else }}null{{ end }},
    "logoUrl": {{ if $logoUrl }}{{ $logoUrl | toJson }}{{ else }}null{{ end }},
    "hue": {{ if regexMatch `^((3[0-5][0-9]|[12][0-9]{2}|[1-9]?[0-9])(\.[0-9]+)?|360(\.0+)?)$` $hue }}{{ $hue }}{{ else }}null{{ end }},
    "supportEmail": {{ if $supportEmail }}{{ $supportEmail | toJson }}{{ else }}null{{ end }},
    "imprintUrl": {{ if $imprintUrl }}{{ $imprintUrl | toJson }}{{ else }}null{{ end }},
    "privacyUrl": {{ if $privacyUrl }}{{ $privacyUrl | toJson }}{{ else }}null{{ end }},
    "termsUrl": {{ if $termsUrl }}{{ $termsUrl | toJson }}{{ else }}null{{ end }}
  }
}
