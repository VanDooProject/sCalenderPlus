# landing: serves the prerendered marketing site (frontend/landing, vite-ssg) as static files
# (docs/architecture/overview.md §1, docs/deployment/coolify.md §13). TLS terminates at Traefik/Coolify;
# the apex → www redirect is configured there too.
#
# Environment:
#   LANDING_PORT   listen port (default 8080; non-root)
#
# Everything the pages show (product name, links, legal pages) is built into the HTML
# (frontend/landing/src/lib/siteConfig.ts): there is no runtime configuration here.

{
	admin off
	auto_https off
	persist_config off
	servers {
		# Traefik (Coolify) sits in front: trust X-Forwarded-* from private networks only.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
	log {
		output stdout
		format json
	}
}

(security_headers) {
	header {
		# Strict CSP like the web app's: the prerendered pages have no inline scripts or styles
		# (checked at build time by frontend/landing/scripts/check-dist.mjs), and nothing is loaded
		# from other origins (fonts are self-hosted, no analytics).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-Via
	}
}

:{$LANDING_PORT:8080} {
	import security_headers
	encode zstd gzip

	log {
		output stdout
		format json
	}

	handle /healthz {
		header Cache-Control "no-store"
		respond "OK" 200
	}

	# Canonical URLs have no trailing slash (/de, /bot): redirect /de/ → /de, keeping the query. Only
	# plain paths: `//evil.example/` must not become a protocol-relative redirect to another host.
	@trailing path_regexp trailing ^(/[A-Za-z0-9][A-Za-z0-9/_.-]*)/$
	redir @trailing {re.trailing.1}{?query} 308

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "public, max-age=0, must-revalidate"
		# Pages are flat files: /bot → bot.html, /de → de.html, / → index.html.
		try_files {path} {path}.html
		file_server
	}

	# Unknown paths: the prerendered not-found page with status 404.
	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		header Cache-Control "no-cache"
		file_server
	}
}
