# Copy to deploy/.env (git-ignored) or set in Coolify. All values are examples.

# Image tag to run (published: X.Y.Z or main-<sha>); `local` = built from this checkout.
APP_VERSION=local
IMAGE_PREFIX=ghcr.io/vandooproject

# Public URL of the web service (feed links, emails).
APP_URL=https://app.example.com
# Shown in the SPA via /config.json (non-production shows a badge).
APP_ENVIRONMENT=production

# External PostgreSQL (Coolify-managed). Leave unset with `--profile with-db` to use the bundled one.
# DATABASE_URL=Host=pg;Port=5432;Database=scal;Username=scal;Password=change-me;Maximum Pool Size=50
# Bundled PostgreSQL password (`--profile with-db`).
POSTGRES_PASSWORD=change-me

# Host port of web, bound to 127.0.0.1 (Coolify/Traefik route to the container port 8080 directly).
WEB_PORT=8080
