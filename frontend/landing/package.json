{
  "name": "landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Marketing site (vite-ssg: prerendered static pages per locale and edition).",
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "check:edition-leak": "node ../app/scripts/check-edition-leak.mjs --root .",
    "render:assets": "node scripts/render-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.51.0",
    "@scalenderplus/plans": "workspace:*",
    "@scalenderplus/ui": "workspace:*",
    "@unhead/vue": "^2.1.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
