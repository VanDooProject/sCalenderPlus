{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "playwright.screenshots.config.ts", "screenshots/**/*.ts", "mocked/**/*.ts", "fullstack/**/*.ts", "landing/**/*.ts", "support/**/*.ts"]
}
